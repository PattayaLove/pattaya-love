---
/**
 * Thank-you page after an "I want this one" click on /shirts/.
 * One static page per motif + size, so Vercel Web Analytics counts each
 * combination as its own path. noindex, not in the sitemap.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Navigation from '../../../../components/Navigation.astro';
import Footer from '../../../../components/Footer.astro';
import Icon from '../../../../components/Icon.astro';
import { motifs, sizes, NOTIFY_EMAIL, type ShirtMotif, type ShirtSize } from '../../../../data/shirts';

export function getStaticPaths() {
  return motifs.flatMap((motif) =>
    sizes.map((size) => ({
      params: { motif: motif.slug, size: size.slug },
      props: { motif, size },
    })),
  );
}

interface Props {
  motif: ShirtMotif;
  size: ShirtSize;
}

const { motif, size } = Astro.props;
const sizeText = size.slug === 'any' ? 'size not decided yet' : `size ${size.label}`;
const subject = `Las Vaginas shirt – ${motif.name} – ${size.slug === 'any' ? 'size tbd' : size.label}`;
const body = `Hi pattaya.love,\n\nplease let me know when the ${motif.name} shirt (${sizeText}) launches.\n\nThanks!`;
const mailto = `mailto:${NOTIFY_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<BaseLayout
  title={`${motif.name} — noted!`}
  description="Thanks for your interest in the Las Vaginas shirts. Get notified when the first run launches."
  noindex
>
  <Navigation />

  <header class="relative w-full pt-28 pb-14 md:pt-36 md:pb-20 bg-navy overflow-hidden grain">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 lg:px-8 grid md:grid-cols-[1fr_280px] gap-10 items-center">
      <div>
        <span class="font-headline text-[10px] md:text-xs font-bold uppercase tracking-[0.3em] text-primary-light mb-4 block">
          Noted
        </span>
        <h1 class="font-headline text-4xl md:text-5xl font-extrabold tracking-tight text-white mb-5">
          Good taste. Questionable, but good.
        </h1>
        <p class="text-white/70 text-lg leading-relaxed">
          We have counted your vote for <strong class="text-white">{motif.name}</strong>, {sizeText}.
          Nothing is charged and nothing is ordered — you just helped us decide what to print.
        </p>
      </div>
      <div class:list={['rounded-3xl p-5', motif.previewBg === 'dark' ? 'bg-navy-light' : 'bg-white']}>
        <Image src={motif.image} alt={`${motif.name} shirt design`} widths={[280, 560]} sizes="280px" format="webp" quality={82} class="w-full h-auto" />
      </div>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-6 lg:px-8 py-16 md:py-20">
    <div class="bg-surface-card rounded-3xl border border-surface-high p-6 md:p-8 shadow-[0_4px_15px_-3px_rgba(0,0,0,0.08)]">
      <h2 class="font-headline text-2xl font-bold text-ink mb-3">Get notified at launch</h2>
      <p class="text-ink-secondary leading-relaxed mb-6">
        Want a heads-up when the first run is ready? Send us a quick email — the subject is
        already filled in. We only use your address to tell you about the launch.
      </p>
      <a
        href={mailto}
        class="inline-flex items-center justify-center gap-2 px-7 h-12 rounded-full bg-primary text-white text-sm font-bold uppercase tracking-widest hover:bg-primary-hover transition-colors"
      >
        <Icon name="mail" class="text-lg" /> Notify me
      </a>
      <p class="text-xs text-ink-muted mt-4">
        Opens your email app. Or write to <span class="font-semibold">{NOTIFY_EMAIL}</span> yourself.
      </p>
    </div>

    <p class="mt-10 text-ink-secondary">
      Like another one too?
      <a href="/shirts/#designs" class="inline-flex items-center gap-1 font-bold text-primary hover:gap-2 transition-all">
        Back to the designs <Icon name="arrow_right_alt" class="text-lg" />
      </a>
    </p>
  </main>

  <Footer />
</BaseLayout>
