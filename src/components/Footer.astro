---
const currentYear = new Date().getFullYear();

const exploreLinks = [
  { label: 'Stay', href: '/stay/' },
  { label: 'Nightlife', href: '/nightlife/' },
  { label: 'Areas', href: '/areas/' },
  { label: 'Guides', href: '/guides/' },
  { label: 'Transport', href: '/guides/bangkok-to-pattaya/' },
  { label: 'Currency Converter', href: '/tools/currency-converter/' },
];

/* Festival campaign strip. Runs until the event and is then deleted in one
   piece — that is why it is not a fifth column in the grid below. */
const FESTIVAL_OVER = new Date('2026-12-14');
const showFestival = new Date() < FESTIVAL_OVER;
const festivalLinks = [
  { label: 'Full guide', href: '/guides/tomorrowland-pattaya-2026/' },
  { label: 'Where to stay', href: '/guides/tomorrowland-hotels-wisdom-valley/' },
  { label: 'Getting there', href: '/guides/tomorrowland-getting-there/' },
  { label: 'Tickets', href: '/guides/tomorrowland-tickets/' },
  { label: 'What to pack', href: '/guides/tomorrowland-packing-guide/' },
  { label: 'The days around it', href: '/guides/tomorrowland-pattaya-itinerary/' },
];

const legalLinks = [
  { label: 'About', href: '/imprint/' },
  { label: 'Privacy Policy', href: '/privacy/' },
  { label: 'Affiliate Disclosure', href: '/affiliate-disclosure/' },
];

const socialLinks = [
  { label: 'Facebook', icon: 'group', href: 'https://www.facebook.com/groups/pattaya.love' },
  { label: 'Instagram', icon: 'photo_camera', href: 'https://www.instagram.com/pattaya.loves' },
  { label: 'YouTube', icon: 'smart_display', href: 'https://youtube.com/@pattaya_love' },
  { label: 'TikTok', icon: 'music_note', href: 'https://www.tiktok.com/@pattaya.love' },
];
import Icon from './Icon.astro';
---

<footer class="bg-navy relative grain">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 pt-20 pb-8">
    <!-- Festival strip — remove after 13 December 2026 -->
    {showFestival && (
      <div class="mb-16 rounded-2xl border border-white/10 bg-white/5 p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-5">
          <h4 class="font-headline text-lg font-bold text-white">Tomorrowland Thailand 2026</h4>
          <p class="text-xs uppercase tracking-[0.2em] text-ink-faint">
            Wisdom Valley &middot; 11&ndash;13 December
          </p>
        </div>
        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {festivalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-faint hover:text-white transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 mb-16">
      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-block mb-4">
          <img src="/images/brand/logo.svg" alt="pattaya.love" class="h-12 w-auto brightness-0 invert" loading="lazy" />
        </a>
        <p class="text-ink-faint text-sm leading-relaxed mb-6 max-w-xs">
          Your ultimate Pattaya guide. Curated for the discerning traveler seeking authentic experiences.
        </p>
        <div class="flex gap-3">
          {socialLinks.map((link) => (
            <a href={link.href} class="w-10 h-10 rounded-xl bg-white/5 hover:bg-primary/20 flex items-center justify-center text-ink-faint hover:text-primary transition-all duration-300" aria-label={link.label}>
              <Icon name={link.icon} class="text-xl" />
            </a>
          ))}
        </div>
      </div>

      <!-- Explore -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white mb-6">Explore</h4>
        <ul class="space-y-3">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-faint hover:text-white transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white mb-6">Legal</h4>
        <ul class="space-y-3">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ink-faint hover:text-white transition-colors duration-200">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.2em] text-white mb-6">Join the Community</h4>
        <p class="text-sm text-ink-faint mb-4">Connect with fellow travelers & expats in our Facebook group.</p>
        <a href="https://www.facebook.com/groups/pattaya.love" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 cta-gradient px-5 py-2.5 rounded-xl text-white text-sm font-bold hover:scale-105 active:scale-95 transition-transform shadow-md shadow-primary/20">
          <Icon name="group" class="text-lg" />
          Join on Facebook
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="h-px bg-white/5 mb-8"></div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-ink-faint/60">
        &copy; {currentYear} pattaya.love &middot; Made with love in Pattaya
      </p>
      <p class="text-xs text-ink-faint/40">
        This site contains affiliate links. We may earn a commission at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
