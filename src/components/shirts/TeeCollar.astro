---
/**
 * Neckline for the shirt close-up on /shirts/. Colours come from the
 * --fabric-* variables set on the surrounding .lv-tee element.
 */
---

<svg class="lv-tee__collar" viewBox="0 0 300 82" aria-hidden="true" focusable="false">
  <path d="M36 0C58 66 242 66 264 0Z" fill="var(--fabric-back)" />
  <rect x="134" y="6" width="32" height="17" rx="2" fill="var(--fabric-rib)" />
  <path
    d="M14 0C40 92 260 92 286 0L264 0C242 66 58 66 36 0Z"
    fill="var(--fabric-rib)"
    stroke="var(--fabric-stitch)"
    stroke-width="1"
  />
  <path
    d="M5 0C33 104 267 104 295 0"
    fill="none"
    stroke="var(--fabric-stitch)"
    stroke-width="1.2"
    stroke-dasharray="3 4"
  />
</svg>
